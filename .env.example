# ===== 应用配置 =====
PORT=3000
# 默认认证策略：jwt | oauth2 | ldap
DEFAULT_AUTH_STRATEGY=jwt

# ===== JWT 配置 =====
JWT_SECRET=please-change-this-secret-in-production
# 访问令牌有效期（秒）
JWT_ACCESS_EXPIRES_IN=3600
# 刷新令牌有效期（秒）
JWT_REFRESH_EXPIRES_IN=604800

# ===== Redis 配置 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 会话在 Redis 中的过期时间（秒）
SESSION_TTL=604800
# 是否允许 Redis 不可用时降级为内存存储（默认 false）。
# 分布式部署严禁开启；仅本地开发/演示可设为 true。
REDIS_ALLOW_MEMORY_FALLBACK=false

# ===== OAuth2.0 配置（授权码模式）=====
OAUTH2_AUTHORIZATION_URL=https://example.com/oauth/authorize
OAUTH2_TOKEN_URL=https://example.com/oauth/token
OAUTH2_USERINFO_URL=https://example.com/oauth/userinfo
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/oauth2/callback
OAUTH2_SCOPE=openid profile email
# 是否允许未配置真实授权服务器时返回模拟用户（默认 false，生产严禁开启）
OAUTH2_ALLOW_MOCK=false

# ===== LDAP 配置 =====
LDAP_URL=ldap://127.0.0.1:389
# 用于绑定用户 DN 的模板，{{username}} 会被替换为登录名
LDAP_BIND_DN_TEMPLATE=uid={{username}},ou=people,dc=example,dc=com
LDAP_SEARCH_BASE=ou=people,dc=example,dc=com
LDAP_SEARCH_FILTER=(uid={{username}})
# 是否允许 LDAP 服务器不可达时降级为模拟认证（默认 false，生产严禁开启）
LDAP_ALLOW_MOCK=false

# ===== 演示用户（JWT 策略）=====
# 是否注入内置演示用户（密码以 bcrypt 哈希存储）。生产环境设为 false。
DEMO_USERS_ENABLED=true
# 演示用户口令（可覆盖默认值），仅用于本地开发
DEMO_ADMIN_PASSWORD=admin123
DEMO_USER_PASSWORD=user123
