# ===== 服务配置 =====
# 服务监听端口
APP_PORT=3000
# 全局接口前缀
APP_PREFIX=api
# 当前启用的认证策略：jwt | oauth2 | ldap
AUTH_STRATEGY=jwt

# ===== JWT 策略配置 =====
# JWT 签名密钥（生产环境请替换为强随机值）
JWT_SECRET=please-change-this-secret-in-production
# Access Token 有效期（单位：秒），默认 1 小时
JWT_EXPIRES_IN=3600
# Refresh Token 有效期（单位：秒），默认 7 天
JWT_REFRESH_EXPIRES_IN=604800

# ===== OAuth2.0 策略配置 =====
# OAuth2 授权服务器地址
OAUTH2_AUTH_URL=https://example-oauth-server.com/oauth/authorize
# OAuth2 Token 端点
OAUTH2_TOKEN_URL=https://example-oauth-server.com/oauth/token
# OAuth2 用户信息端点
OAUTH2_USERINFO_URL=https://example-oauth-server.com/oauth/userinfo
# 客户端 ID
OAUTH2_CLIENT_ID=your-client-id
# 客户端密钥
OAUTH2_CLIENT_SECRET=your-client-secret
# 回调地址
OAUTH2_CALLBACK_URL=http://localhost:3000/api/auth/oauth2/callback

# ===== LDAP 策略配置 =====
# LDAP 服务器地址（例如 ldap://localhost:389）
LDAP_URL=ldap://localhost:389
# LDAP 绑定用户 DN（用于搜索）
LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP 绑定密码
LDAP_BIND_CREDENTIALS=admin
# 用户搜索基准 DN
LDAP_SEARCH_BASE=dc=example,dc=com
# 用户搜索过滤条件，{{username}} 会被替换为实际用户名
LDAP_SEARCH_FILTER=(uid={{username}})

# ===== Redis 配置 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 会话在 Redis 中的 key 前缀
REDIS_SESSION_PREFIX=auth:session:
# Redis 连接失败时是否降级到内存存储（便于本地无 Redis 开发）
REDIS_FALLBACK_MEMORY=true
