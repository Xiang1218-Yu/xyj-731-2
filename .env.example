# ==========================================================
# 统一身份认证服务 - 环境变量配置示例
# 复制本文件为 .env 并根据实际环境修改
# ==========================================================

# 服务运行端口
PORT=3000

# 当前运行环境: development | production | test
NODE_ENV=development

# 是否允许外部认证不可用时回退到本地用户库 (便于本地开发/测试)
# production 环境建议设置为 false
ALLOW_LOCAL_FALLBACK=true

# ---------- JWT 配置 ----------
# JWT 签名密钥 (生产环境请使用强随机字符串并通过密钥管理系统注入)
JWT_SECRET=please-change-this-secret-in-production
# Access Token 有效期
JWT_EXPIRES_IN=15m
# Refresh Token 有效期
JWT_REFRESH_EXPIRES_IN=7d
# JWT 签发者
JWT_ISSUER=unified-auth-service

# ---------- Redis 会话存储配置 ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 会话 key 前缀
REDIS_KEY_PREFIX=auth:session:
# 会话默认有效期(秒), 默认 86400 = 24 小时
SESSION_TTL=86400
# Redis 连接不可用时是否自动降级为内存存储 (开发环境友好)
REDIS_FALLBACK_MEMORY=true

# ---------- OAuth2.0 配置 ----------
# OAuth2 授权服务器地址
OAUTH2_AUTHORIZATION_URL=https://example-oauth2-server.com/oauth/authorize
OAUTH2_TOKEN_URL=https://example-oauth2-server.com/oauth/token
OAUTH2_USERINFO_URL=https://example-oauth2-server.com/oauth/userinfo
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
OAUTH2_CALLBACK_URL=http://localhost:3000/api/auth/oauth2/callback
# OAuth2 scope, 多个使用空格分隔
OAUTH2_SCOPE=openid profile email

# ---------- LDAP 配置 ----------
LDAP_URL=ldap://127.0.0.1:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_CREDENTIALS=admin-password
# 用户搜索基准 DN
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
# 用户登录名对应的 LDAP 属性
LDAP_SEARCH_FILTER=(uid={{username}})
